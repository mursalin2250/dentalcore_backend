NODE_ENV=
PORT=
MONGO_URI=
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=
# Optional comma-separated extra origins (production or fixed ngrok URL)
# CLIENT_ORIGINS=https://your-subdomain.ngrok-free.app
# Number of reverse proxies in front of the API (0 = none). Needed for correct rate limiting in production.
# Set to 1 when the API sits behind ngrok or another reverse proxy
TRUST_PROXY=

# Used only by `npm run seed`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
